PAYLOAD_SECRET=change-me-to-a-long-random-string
PREVIEW_SECRET=change-me-too
# CMS content (Payload). Local: SQLite file. Production: libSQL/Turso URL, or switch to Postgres (see docs/CMS.md)
DATABASE_URL=file:./data/cms.db
DATABASE_AUTH_TOKEN=
# Operations: orders, tickets, scans, campaign events, leads. Keep it separate from the CMS.
OPS_DATABASE_URL=file:./data/ops.db
OPS_DATABASE_TOKEN=
# Public site address, for canonical links, the sitemap and live preview
NEXT_PUBLIC_SITE_URL=https://www.niccoparks.com
NEXT_PUBLIC_SERVER_URL=
# 0 = don't load the starter content into an empty CMS database
AUTO_SEED=1
# 0 = don't generate demo bookings for the Operations dashboard (and hide the demo note)
OPS_DEMO_DATA=1

# ── Email (where enquiries are sent from). Without SMTP, emails are written to the server log.
# Who receives what is set in the CMS: Integrations → Email & notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@niccoparks.com

# ── Ticketing. Mode is chosen in CMS → Integrations → Ticketing; this forces it (demo | linkout | semnox).
TICKETING_MODE=
# Semnox API (ask Semnox for documentation, a UAT site and credentials). Server-only, never NEXT_PUBLIC_.
SEMNOX_API_BASE_URL=
SEMNOX_API_USER=
SEMNOX_API_KEY=
SEMNOX_WEBHOOK_SECRET=

# ── Daily leads summary from an outside scheduler (optional; it also runs by itself at 9:00 IST)
# curl -X POST -H "Authorization: Bearer $CRON_SECRET" https://…/api/ops/leads/digest
CRON_SECRET=

# ── Server-side conversions (CMS → Tracking → Server-side conversions must be ticked)
GA4_API_SECRET=
META_CAPI_TOKEN=

# ── Chat assistant "AI" mode (CMS → Integrations → Chat assistant)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
