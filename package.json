{
  "name": "niccopark-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "dev:lan": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "export": "node scripts/export-static.mjs",
    "typecheck": "tsc --noEmit",
    "i18n:check": "node scripts/i18n-check.mjs",
    "payload": "payload",
    "seed": "payload run scripts/seed.ts",
    "ops:demo": "payload run scripts/ops-demo.ts",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "migrate:create": "payload migrate:create",
    "migrate": "payload migrate",
    "seed:fresh": "node scripts/reset-cms.mjs && payload run scripts/seed.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@payloadcms/db-sqlite": "3.90.2",
    "@payloadcms/email-nodemailer": "3.90.2",
    "@payloadcms/live-preview-react": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "clsx": "^2.1.1",
    "graphql": "^16.14.2",
    "lucide-react": "^1.16.0",
    "next": "16.3.8",
    "payload": "3.90.2",
    "react": "^19",
    "react-dom": "^19",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3"
  }
}
